APP_NAME="FTS Restaurant AI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Display timezone (config/restaurant.php). Timestamps are stored in UTC.
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local development uses SQLite (file: database/database.sqlite; `php artisan migrate` creates it if missing).
# Production and CI use PostgreSQL 17: set DB_CONNECTION=pgsql and the DB_* values below.
DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=restaurant_ai
# DB_USERNAME=restaurant_ai
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=720
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Retention (config/restaurant.php): days, except draft grace in hours
RETENTION_CONVERSATION_DAYS=30
RETENTION_REQUEST_DAYS=180
RETENTION_GUEST_SESSION_DAYS=30
RETENTION_AUDIT_DAYS=365
RETENTION_DRAFT_GRACE_HOURS=24
RETENTION_RECEIPT_DAYS=365

# Scene images: local (final illustrations in public/assets/restaurant) or placeholder (dev only)
SCENE_IMAGE_SOURCE=local
SCENE_PLACEHOLDER_BASE_URL=https://picsum.photos

ASSISTANT_ENABLED=false
# Public guest AI budget: turns per guest session per day, and a global daily cap.
ASSISTANT_GUEST_DAILY_TURNS=40
ASSISTANT_DAILY_TURN_CAP=2000
# Tool calling (search, own tickets, ticket drafts). false for providers without function calling.
ASSISTANT_TOOLS_ENABLED=true
LOCAL_LLM_BASE_URL=
LOCAL_LLM_API_KEY=
LOCAL_LLM_MODEL=
# Optional provider capability, e.g. "none" for thinking models (LM Studio Qwen3).
ASSISTANT_REASONING_EFFORT=
# Optional CA bundle file for TLS to the provider (when PHP has no CA configured).
LOCAL_LLM_CA_BUNDLE=

VITE_APP_NAME="${APP_NAME}"

# Operations alert: pending requests older than this (minutes) while the restaurant is open
OPS_PENDING_ALERT_MINUTES=120
