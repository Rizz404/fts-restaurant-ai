# FTS Restaurant AI — production environment template (PLAN_08).
# Copy to the server's shared .env (mode 0600, owned by the deploy user).
# Never commit real values. Fill every <...>.

APP_NAME="FTS Restaurant AI"
APP_ENV=production
APP_KEY=<php artisan key:generate --show>
APP_DEBUG=false
APP_URL=https://<hostname>
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null

# PostgreSQL 17, reachable only from the app/worker hosts.
DB_CONNECTION=pgsql
DB_HOST=<db-host>
DB_PORT=5432
DB_DATABASE=restaurant_ai
DB_USERNAME=restaurant_ai
DB_PASSWORD=<secret>

SESSION_DRIVER=database
SESSION_LIFETIME=720
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
# v1 notifications are synchronous; set true only when queued jobs exist.
QUEUE_WORKER_REQUIRED=false

MAIL_MAILER=log

# Reverse proxy / CDN in front of nginx: the real client IP is needed for rate limits.
# Comma-separated proxy IPs or CIDRs (use "*" only if the app is reachable through the proxy alone).
# Empty means "no proxy is trusted" and the limiter sees the proxy's IP.
TRUSTED_PROXIES=

# The app sends Content-Security-Policy and the other security headers itself.
# nginx sends Strict-Transport-Security, so keep this false to avoid a duplicate.
SECURITY_CSP=true
SECURITY_HSTS=false

RETENTION_CONVERSATION_DAYS=30
RETENTION_REQUEST_DAYS=180
RETENTION_GUEST_SESSION_DAYS=30
RETENTION_AUDIT_DAYS=365
RETENTION_DRAFT_GRACE_HOURS=24
RETENTION_RECEIPT_DAYS=365

# Production always serves the local illustrations.
SCENE_IMAGE_SOURCE=local

# AI provider (HTTPS required in production; base URL without /v1).
ASSISTANT_ENABLED=true
ASSISTANT_GUEST_DAILY_TURNS=40
ASSISTANT_DAILY_TURN_CAP=2000
ASSISTANT_TOOLS_ENABLED=true
LOCAL_LLM_BASE_URL=https://<provider-host>
LOCAL_LLM_API_KEY=<secret>
LOCAL_LLM_MODEL=<model-alias>
ASSISTANT_REASONING_EFFORT=
LOCAL_LLM_CA_BUNDLE=

# Operations alert: pending requests older than this (minutes) while the restaurant is open
OPS_PENDING_ALERT_MINUTES=120
